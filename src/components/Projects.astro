---
import Icon from './Icon.astro';
import { copy, projects } from '../data/profile.js';

const { lang } = Astro.props;
const c = copy[lang].projects;

const C = 200;
const R_OUT = 172;
const R_IN = 118;
const GAP = 2.2;
const step = 360 / projects.length;

const point = (r, deg) => {
  const a = (deg * Math.PI) / 180;
  return `${(C + r * Math.cos(a)).toFixed(2)} ${(C + r * Math.sin(a)).toFixed(2)}`;
};

const sector = (i) => {
  const start = -90 + i * step + GAP;
  const end = -90 + (i + 1) * step - GAP;
  const large = end - start > 180 ? 1 : 0;
  return [
    `M ${point(R_OUT, start)}`,
    `A ${R_OUT} ${R_OUT} 0 ${large} 1 ${point(R_OUT, end)}`,
    `L ${point(R_IN, end)}`,
    `A ${R_IN} ${R_IN} 0 ${large} 0 ${point(R_IN, start)}`,
    'Z',
  ].join(' ');
};

const centerOf = (i) => -90 + i * step + step / 2;
---
<section id="projects" class="section" data-projects style={`--p-color: ${projects[0].color}`}>
  <div class="wrap">
    <div class="section-head">
      <span class="label">~/{lang === 'es' ? 'proyectos' : 'projects'}</span>
      <h2>{c.title}</h2>
      <p>{c.lead}</p>
    </div>

    <div class="layout">
      <div class="left">
        <div class="wheel">
          <svg class="donut" viewBox="0 0 400 400" role="group" aria-label={c.title}>
            <g class="ring" data-ring>
              {projects.map((p, i) => (
                <path
                  class:list={['slice', { active: i === 0 }]}
                  d={sector(i)}
                  fill={p.color}
                  style={`--glow: ${p.color}`}
                  data-slice={i}
                  data-center={centerOf(i)}
                  tabindex="0"
                  role="button"
                  aria-label={p.name}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                />
              ))}
            </g>
            <circle class="progress-track" cx={C} cy={C} r="104" />
            <circle class="progress" cx={C} cy={C} r="104" pathLength="100" data-progress />
          </svg>

          <div class="hub">
            {projects.map((p, i) => (
              <div class:list={['hub-item', { active: i === 0 }]} data-hub={i}>
                {p.logos.length
                  ? <img src={p.logos[0]} alt="" loading="lazy" decoding="async" />
                  : <span class="wordmark" style={`color: ${p.color}`}>{p.name}</span>}
              </div>
            ))}
            <span class="counter" data-counter>01 / {String(projects.length).padStart(2, '0')}</span>
          </div>
        </div>

        <ul class="legend">
          {projects.map((p, i) => (
            <li>
              <button type="button" class:list={{ active: i === 0 }} data-pick={i} style={`--dot: ${p.color}`}>
                <span class="dot"></span>{p.name}
              </button>
            </li>
          ))}
        </ul>
      </div>

      <div class="panels">
        {projects.map((p, i) => {
          const d = p[lang];
          const live = !/desarrollo|development/i.test(d.status);
          return (
            <article class:list={['panel', { active: i === 0 }]} data-panel={i} style={`--p-color: ${p.color}`} aria-hidden={i === 0 ? 'false' : 'true'}>
              <div class="panel-head">
                <div class="logos">
                  {p.logos.length
                    ? p.logos.map((l) => <span class="logo-tile"><img src={l} alt={p.name} loading="lazy" decoding="async" /></span>)
                    : <span class="logo-tile"><span class="wordmark small" style={`color: ${p.color}`}>{p.name}</span></span>}
                </div>
                <div class="meta">
                  <span class="kind">{d.kind}</span>
                  <span class:list={['status', { live }]}>{d.status}</span>
                </div>
              </div>
              <h3>{p.name}</h3>
              <p class="summary">{d.summary}</p>
              <ul class="points">
                {d.points.map((x) => <li>{x}</li>)}
              </ul>
              <ul class="stack">
                {p.stack.map((s) => <li class="chip">{s}</li>)}
              </ul>
              <a class="visit" href={p.url} target="_blank" rel="noopener" tabindex={i === 0 ? 0 : -1}>
                {c.visit} {p.url.replace(/^https?:\/\//, '')}<Icon name="arrow" />
              </a>
            </article>
          );
        })}
      </div>
    </div>

  </div>
</section>

<script>
  import { mountProjects } from '../scripts/projects.js';

  const root = document.querySelector('[data-projects]');
  if (root) mountProjects(root);
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 56px;
    align-items: start;
  }

  .left { display: grid; justify-items: center; gap: 28px; }
  .wheel { position: relative; width: 100%; max-width: 440px; aspect-ratio: 1; }
  .donut { width: 100%; height: 100%; overflow: visible; }
  .ring {
    transform-box: view-box;
    transform-origin: 200px 200px;
    transition: transform 1.1s cubic-bezier(.65, 0, .25, 1);
  }
  .slice {
    cursor: pointer;
    opacity: .32;
    transform-box: view-box;
    transform-origin: 200px 200px;
    transition: transform .6s cubic-bezier(.22, 1, .36, 1), opacity .45s ease, filter .45s ease;
    outline: none;
  }
  .slice:hover, .slice:focus-visible { opacity: .7; transform: scale(1.045); }
  .slice.active {
    opacity: 1;
    transform: scale(1.1);
    filter: drop-shadow(0 0 18px color-mix(in srgb, var(--glow) 55%, transparent));
  }

  .progress-track { fill: none; stroke: var(--line); stroke-width: 2; }
  .progress {
    fill: none;
    stroke: var(--p-color);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transform: rotate(-90deg);
    transform-box: view-box;
    transform-origin: 200px 200px;
    opacity: .9;
    transition: stroke .5s ease;
  }
  .progress.run { animation: fill var(--dur, 6.5s) linear forwards; }
  .progress.paused { animation-play-state: paused; }
  @keyframes fill { to { stroke-dashoffset: 0; } }

  .hub {
    position: absolute;
    inset: 30%;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .hub-item {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    opacity: 0;
    transform: scale(.85);
    transition: opacity .5s ease, transform .6s cubic-bezier(.22, 1, .36, 1);
  }
  .hub-item.active { opacity: 1; transform: scale(1); }
  .hub-item img { width: 72%; height: 72%; object-fit: contain; }
  .wordmark { font-family: var(--mono); font-weight: 800; font-style: italic; letter-spacing: .04em; text-transform: uppercase; font-size: 20px; }
  .wordmark.small { font-size: 13px; }
  .counter {
    position: absolute;
    bottom: -4px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: .08em;
  }

  .panels { display: grid; }
  .panel {
    grid-area: 1 / 1;
    align-self: start;
    display: flex;
    flex-direction: column;
    padding: 28px;
    border: 1px solid var(--line);
    border-top: 2px solid var(--p-color);
    border-radius: var(--radius);
    background: linear-gradient(180deg, color-mix(in srgb, var(--p-color) 7%, var(--surface)), var(--bg-2) 60%);
    opacity: 0;
    visibility: hidden;
    transform: translateY(14px);
    transition: opacity .5s ease, transform .6s cubic-bezier(.22, 1, .36, 1), visibility 0s linear .5s;
  }
  .panel.active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity .55s ease .12s, transform .7s cubic-bezier(.22, 1, .36, 1) .12s, visibility 0s;
  }
  .panel-head { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; flex-wrap: wrap; }
  .logos { display: flex; gap: 8px; }
  .logo-tile {
    display: grid;
    place-items: center;
    height: 52px;
    min-width: 52px;
    padding: 8px 10px;
    border-radius: 12px;
    background: var(--bg);
    border: 1px solid var(--line-2);
  }
  .logo-tile img { height: 34px; width: auto; max-width: 120px; object-fit: contain; }
  .meta { display: grid; justify-items: end; gap: 6px; }
  .kind { font-family: var(--mono); font-size: 12.5px; color: var(--muted); }
  .status {
    font-size: 12px;
    font-weight: 550;
    color: var(--warn);
    background: rgba(255, 209, 102, 0.1);
    border: 1px solid rgba(255, 209, 102, 0.25);
    padding: 2px 9px;
    border-radius: 999px;
  }
  .status.live { color: var(--accent); background: var(--accent-soft); border-color: var(--accent-line); }
  h3 { margin-top: 20px; font-size: 28px; font-weight: 650; }
  .summary { margin-top: 8px; font-size: 16.5px; }
  .points { margin-top: 18px; display: grid; gap: 9px; color: var(--text-2); font-size: 14.5px; line-height: 1.55; }
  .points li { position: relative; padding-left: 18px; }
  .points li::before { content: '›'; position: absolute; left: 2px; color: var(--p-color); font-weight: 700; }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 22px; }
  .visit {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: flex-start;
    margin-top: 20px;
    font-family: var(--mono);
    font-size: 13.5px;
    color: var(--p-color);
  }
  .visit :global(svg) { width: 16px; height: 16px; transition: transform .25s ease; }
  .visit:hover :global(svg) { transform: translate(2px, -2px); }

  .legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; max-width: 460px; }
  .legend button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: var(--bg-2);
    color: var(--text-2);
    font: inherit;
    font-size: 13.5px;
    cursor: pointer;
    transition: color .3s ease, border-color .3s ease, background .3s ease, transform .3s ease;
  }
  .legend button:hover { color: var(--text); transform: translateY(-1px); }
  .legend button.active { color: var(--text); border-color: color-mix(in srgb, var(--dot) 55%, transparent); background: color-mix(in srgb, var(--dot) 10%, var(--bg-2)); }
  .legend .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--dot); }

  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; gap: 32px; }
    .wheel { max-width: 340px; }
  }
  @media (max-width: 640px) {
    .panel { padding: 22px 18px; }
    h3 { font-size: 24px; }
    .meta { justify-items: start; }
  }
</style>
